# Free key from https://developer.tomtom.com (routing + geocoding)
TOMTOM_API_KEY=

# Optional. Weather works without a key (free tier). Only set this if you buy an Open-Meteo plan.
OPEN_METEO_API_KEY=

# true = run with built-in demo data (no API keys, no internet). Good for a quick look.
USE_FAKE_PROVIDERS=false

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Countries used for address search (ISO codes, comma separated)
GEOCODE_COUNTRY_SET=US,CA

# Optional: use Redis instead of in-memory caching (e.g. redis://localhost:6379/0)
REDIS_URL=